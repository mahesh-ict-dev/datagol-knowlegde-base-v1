{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=*, camera=*, autoplay=*, display-capture=*"
        },
        {
          "key": "Feature-Policy",
          "value": "microphone *; camera *; autoplay *"
        }
      ]
    }
  ]
}

