						],
						"url": {
							"raw": "{{base_url}}/noCo/api/v2/workspaces/:workspaceId/tables?isIncludeColumns=true",
							"host": ["{{base_url}}"],
							"path": ["noCo", "api", "v2", "workspaces", ":workspaceId", "tables"],
