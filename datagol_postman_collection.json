							"raw": "{\n    \"uiDataType\": \"FORMULA\",\n    \"uiMetadata\": {\n        \"title\": \"sample demo formula\"\n    },\n    \"formula\": \"length(name)\",\n    \"formulaType\": \"SQL\",\n    \"name\": \"sample_demo_formula\"\n}"
